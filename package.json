{
  "name": "performante-lab-frontend",
  "version": "0.0.0",
  "scripts": {
    "config:auth": "node scripts/write-auth-config.mjs",
    "prestart": "npm run config:auth",
    "prebuild": "npm run config:auth && npm run assets:cars && npm run assets:parts && npm run assets:views && npm run assets:builds",
    "prewatch": "npm run config:auth",
    "ng": "ng",
    "start": "node scripts/run-with-car-images.mjs serve",
    "build": "ng build",
    "watch": "node scripts/run-with-car-images.mjs build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:Performante_Lab_Frontend": "node dist/Performante_Lab_Frontend/server/server.mjs",
    "assets:cars": "node scripts/write-car-image-manifest.mjs",
    "assets:parts": "node scripts/write-part-image-manifest.mjs",
    "assets:views": "node scripts/write-car-view-manifest.mjs",
    "assets:builds": "node scripts/write-build-catalog.mjs",
    "test:assets": "node --test scripts/car-image-watch.test.mjs"
  },
  "private": true,
  "packageManager": "npm@11.17.0",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/platform-server": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@angular/ssr": "^22.1.2",
    "@fortawesome/angular-fontawesome": "^5.1.0",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@supabase/supabase-js": "^2.118.0",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.2",
    "@angular/cli": "^22.1.2",
    "@angular/compiler-cli": "^22.1.0",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.12",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
